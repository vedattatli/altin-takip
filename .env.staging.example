# ---------------------------------------------------------------------------
# Altın Takip — STAGING ortam değişkenleri örneği
#
# Bu dosyayı ".env.staging.local" olarak kopyalayın ve doldurun.
# .env.staging.local gitignore'dadır, kaynak ZIP'e girmez, betikler değerleri yazdırmaz.
# Gerçek secretları README veya sohbete YAZMAYIN.
# ---------------------------------------------------------------------------

# Tam olarak "staging" olmalı; production hedefi reddedilir.
STAGING_ENVIRONMENT=staging

# Sabit staging adresi (Vercel proje URL'si veya alias). APP_ORIGIN ile BİREBİR aynı olmalı.
STAGING_BASE_URL=https://altin-takip-staging.vercel.app
APP_ORIGIN=https://altin-takip-staging.vercel.app

# Supabase staging projesi (production DEĞİL).
SUPABASE_STAGING_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=https://<staging-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# YALNIZCA sunucu; NEXT_PUBLIC_ önekiyle ASLA kullanılmaz.
SUPABASE_SECRET_KEY=
# Data API sondası (staging:smoke) authenticated JWT üretmek için: Project Settings → API → JWT Secret
SUPABASE_STAGING_JWT_SECRET=
# Varsa production ref'i: staging araçları bununla eşleşen hedefe dokunmaz.
SUPABASE_PRODUCTION_PROJECT_REF=

# Güvenlik (openssl rand -base64 48)
AUTH_CSRF_SECRET=
RATE_LIMIT_PEPPER=
TRUSTED_PROXY_PROVIDER=vercel
AUTH_INTERNAL_EMAIL_DOMAIN=users.altin-takip.invalid

# Demo modu staging'de kapalıdır (true olamaz).
NEXT_PUBLIC_ENABLE_DEMO_MODE=false

# Vercel staging projesi adı (bilgi amaçlı; doctor raporlar)
VERCEL_STAGING_PROJECT=altin-takip-staging

# --- Sprint 3: fiyat kaynakları ve yönetici MFA ---
# Zamanlanmış alım ucu secret'ı (boşsa uç kapalıdır).
PRICE_CRON_SECRET=
# Yönetici TOTP şifreleme anahtarı (32 bayt). Yoksa yönetim işlemleri açılmaz.
AUTH_MFA_ENCRYPTION_KEY=
# Sağlayıcı anahtarları .env.example içindeki adlarla aynıdır; lisans onayı olmadan
# REDISTRIBUTION_ALLOWED "true" YAPILMAZ.
