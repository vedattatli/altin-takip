# ---------------------------------------------------------------------------
# Altın Takip — ortam değişkenleri örneği
#
# Bu dosyayı ".env.local" olarak kopyalayın ve doldurun.
# .env.local ASLA commit edilmez (.gitignore ile dışlanmıştır).
# ---------------------------------------------------------------------------

# Supabase proje URL'si. Örn. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase "anon" (public) anahtarı. Tarayıcıya gidebilir; RLS ile korunur.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase sunucu anahtarı (tercih edilen: yeni "sb_secret_..." biçimi).
# YALNIZCA SUNUCUDA kullanılır. NEXT_PUBLIC_ öneki ASLA verilmez; API yanıtına
# veya istemci paketine girmez (npm run verify:bundle bunu tarar).
# Bu anahtar RLS'yi ATLAR; birincil güvenlik sınırı sunucu tarafı actor
# authorization'dır (bkz. docs/SECURITY.md).
SUPABASE_SECRET_KEY=

# Geriye uyumluluk: eski "service_role" JWT anahtarı. SUPABASE_SECRET_KEY
# doluysa bu yok sayılır. Üretimde ikisinden biri ZORUNLUDUR.
SUPABASE_SERVICE_ROLE_KEY=

# Kullanıcı adından türetilen dahili kimliğin alan adı.
# Bu adrese e-posta gönderilmez; kullanıcıya hiçbir ekranda gösterilmez.
# Kendi kontrolünüzdeki bir alan adı veya ayrılmış ".invalid" uzantısı kullanın.
AUTH_INTERNAL_EMAIL_DOMAIN=users.altin-takip.invalid

# Oturum çerezi adı. Üretimde otomatik olarak __Host- öneki alır.
# Oturum ömrü koddadır (src/auth/types.ts):
#   "oturumumu açık tut" işaretli -> kalıcı çerez, 180 gün kaydırmalı, kimlik 7 günde bir yenilenir
#   işaretsiz                     -> tarayıcı oturumu çerezi, 8 saat mutlak, 30 dk hareketsizlik
#   admin                         -> her zaman 8 saat mutlak, 15 dk hareketsizlik
AUTH_SESSION_COOKIE=altin_takip_session

# ---------------------------------------------------------------------------
# FİYAT KAYNAKLARI (Sprint 3)
#
# KURAL: API anahtarları YALNIZCA sunucudadır; NEXT_PUBLIC_ öneki ASLA verilmez.
# Bir kaynak, yeniden gösterim izni açıkça "true" işaretlenmeden üretimde
# etkinleştirilemez (fail closed). Sözleşmesi olmayan kaynak için adres yazılmaz.
# ---------------------------------------------------------------------------

# Zamanlanmış fiyat alımı ucu (/api/cron/price-ingestion) için paylaşılan secret.
# Boşsa uç KAPALIDIR. Üretmek için: openssl rand -base64 32
PRICE_CRON_SECRET=

# Alım aralığı (ms). 15000 (15 sn) ile 300000 (5 dk) arasına sıkıştırılır.
PRICE_INGESTION_INTERVAL_MS=60000
# Fiyatın bayat sayılacağı süre (ms).
PRICE_STALE_AFTER_MS=300000
# Anomali eşiği: önceki fiyata göre izin verilen en büyük oransal değişim.
PRICE_MAX_CHANGE_RATIO=0.15
# Alış-satış makasının bozdurma fiyatına oranı bu değeri aşarsa quote karantinaya alınır.
PRICE_MAX_SPREAD_RATIO=0.25
# Makul fiyat aralığı (TL). Bu aralığın dışındaki quote karantinaya alınır.
PRICE_MIN_TRY=1
PRICE_MAX_TRY=100000000

# --- Sprint 3.1 kapıları ---
# Test verisi sağlayıcısının AYRI kapısı. Yerel auth kapısından (AUTH_ALLOW_LOCAL_BACKEND)
# bağımsızdır ve YALNIZCA test koşucusu tarafından ayarlanır. Gerçek üretim dağıtımında
# (VERCEL_ENV=production veya APP_DEPLOYMENT_ENV=production) hiçbir etkisi yoktur.
PRICE_ALLOW_MOCK_PROVIDER=
# Dağıtım ortamı. "production" ise test verisi ve deneysel toplayıcı KOŞULSUZ kapalıdır.
APP_DEPLOYMENT_ENV=
# Deneysel Sarraf TV ekran toplayıcısı (yalnızca yerel/özel staging). Üretimde yok sayılır.
PRICE_EXPERIMENTAL_SARRAF_SCREEN=false
# Özel pilot ikinci anahtarı. Deneysel ekran kaynağı YALNIZCA
# APP_DEPLOYMENT_ENV=private-pilot iken ve BU bayrak da true iken çalışır.
# Tek bir değişkenin yanlışlıkla açık kalması yetmez.
PRICE_EXPERIMENTAL_PRIVATE_PILOT=false
# Sağlayıcı sözleşme beyanı: fixture ile doğrulanmış sürüm adı yazılır. Yalnızca adres ve
# anahtar girilmesi taslak adapter'ı üretim adapter'ı YAPMAZ.
ALTINAPI_CONTRACT_VERSION=
HASFIYAT_CONTRACT_VERSION=
SARRAFPRO_CONTRACT_VERSION=

# --- Kayseri Yerel Piyasa (Sarraf Pro / KAYSARDER) ---
# KAYSARDER sayfası scrape EDİLMEZ; tv.sarraf.pro trafiği reverse engineer EDİLMEZ.
# Aşağıdaki adres YALNIZCA yetkili API/XML sözleşmesiyle verilen adrestir.
SARRAFPRO_API_URL=
SARRAFPRO_API_KEY=
SARRAFPRO_MARKET_ID=
SARRAFPRO_LICENSE_REFERENCE=
SARRAFPRO_REDISTRIBUTION_ALLOWED=false

# --- AltinAPI (bağımsız veri sağlayıcısı; bir kurumun resmî servisi DEĞİLDİR) ---
ALTINAPI_API_URL=
ALTINAPI_API_KEY=
ALTINAPI_LICENSE_TIER=
ALTINAPI_REDISTRIBUTION_ALLOWED=false

# --- Hasfiyat (çoklu kaynak birleşimi) ---
# HASFIYAT_SOURCE verilirse üst kaynak açıkça seçilir ve arayüzde gösterilir;
# verilmezse veri "Çoklu Kaynak" olarak etiketlenir.
HASFIYAT_API_URL=
HASFIYAT_API_KEY=
HASFIYAT_SOURCE=
HASFIYAT_LICENSE_REFERENCE=
HASFIYAT_REDISTRIBUTION_ALLOWED=false

# ---------------------------------------------------------------------------
# YÖNETİCİ İKİNCİ FAKTÖRÜ (TOTP)
#
# TOTP secret'ı veritabanında düz metin tutulmaz; bu anahtarla AES-256-GCM ile
# şifrelenir. 32 baytlık değer (base64 veya hex): openssl rand -base64 32
# Anahtar yoksa yönetim işlemleri açılmaz (fail closed).
# ---------------------------------------------------------------------------
AUTH_MFA_ENCRYPTION_KEY=

# Muhasebe: fiyatlar bu sürümde MockPriceProvider (TEST VERİSİ); gerçek sağlayıcı yoktur.
# Test kancası (yalnızca otomatik testler): virgülle ayrılmış ürün kimlikleri için test
# sağlayıcısı fiyat ÜRETMEZ ("hiç fiyat yok" / "kısmi değerleme" senaryoları).
# PRICE_MOCK_UNAVAILABLE_PRODUCTS=
# Staging yapılandırması ayrı dosyadadır: .env.staging.example → .env.staging.local
# Data API sondası (npm run test:data-api) yerel yığın anahtarlarını `supabase status`tan okur;
# uzak bir yığın için SUPABASE_PROBE_URL / _ANON_KEY / _SERVICE_KEY / _JWT_SECRET verilebilir.

# Demo modu. YALNIZCA geliştirme ortamında çalışır; üretim derlemesinde yok sayılır.
# Açıkken /demo adresi erişilebilir olur. Giriş ekranında demo bağlantısı gösterilmez.
NEXT_PUBLIC_ENABLE_DEMO_MODE=false

# ---------------------------------------------------------------------------
# GÜVENLİK (Sprint 0.5)
# ---------------------------------------------------------------------------

# CSRF jetonlarını imzalamak için gizli anahtar.
# ÜRETİMDE ZORUNLUDUR; yoksa durum değiştiren istekler reddedilir.
# Üretmek için: openssl rand -base64 48
AUTH_CSRF_SECRET=

# Hız sınırlayıcı anahtarlarını (IP + kullanıcı adı) gizlemek için pepper.
# ÜRETİMDE ZORUNLUDUR. Değiştirilirse mevcut sayaçlar sıfırlanır.
# Üretmek için: openssl rand -base64 48
RATE_LIMIT_PEPPER=

# Uygulamanın beklenen origin'i (CSRF / same-origin kontrolü için).
# Örn. https://altin-takip.ornek.com
# ÜRETİMDE ZORUNLUDUR: boşsa Host/X-Forwarded-Host'tan TÜRETİLMEZ ve durum
# değiştiren tüm istekler "misconfigured" hatasıyla reddedilir (fail closed).
# Geliştirmede boş bırakılabilir; istek başlıklarından türetilir.
APP_ORIGIN=

# Güvenilir ters vekil sağlayıcısı: vercel | local | none
# X-Forwarded-For / X-Real-IP başlıkları YALNIZCA güvenilir sağlayıcıda
# dikkate alınır. Bilinmeyen değer veya "none" => başlıklar yok sayılır;
# saldırgan başlıkla kendine IP uyduramaz. Üretimde boşsa "none" varsayılır.
# Ham IP hiçbir log veya tabloya yazılmaz; yalnızca HMAC'li sayaç anahtarına girer.
TRUSTED_PROXY_PROVIDER=

# --- Gunluk uygulama yedegi ---
# AES-256-GCM anahtari: 32 bayt, base64. YALNIZ sunucu secret store'unda durur.
# Yedegin icine YAZILMAZ; anahtar kaybolursa yedekler cozulemez.
BACKUP_ENCRYPTION_KEY=
# Yedek cron ucunun secret'i. Yoksa uc KAPALIDIR (fail closed).
BACKUP_CRON_SECRET=
